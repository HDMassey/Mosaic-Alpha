# MosaicAlpha environment variables
# Copy this file to .env and fill in the values you need.
# The .env file is listed in .gitignore and must never be committed.

# ── FRED API key ──────────────────────────────────────────────────────────────
# Required only for live FRED macro pulls (mosaic run-macro-sector).
# Free registration: https://fred.stlouisfed.org/docs/api/api_key.html
# Leave blank or omit entirely if you are using offline/cached data only.
FRED_API_KEY=

# ── Notes ─────────────────────────────────────────────────────────────────────
# GDELT does not require an API key.
# Use --offline-sample on any news command to skip GDELT network calls entirely:
#   mosaic run-news-sector --offline-sample
#   mosaic run-backtest --offline-sample
#
# Yahoo Finance (yfinance) does not require an API key.
